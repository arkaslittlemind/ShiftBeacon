AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/shiftbeacon?schema=public

# Error monitoring (optional - absent means Sentry is simply disabled).
# Only active when NODE_ENV=production. SENTRY_AUTH_TOKEN is build-time only,
# used to upload source maps; the Sentry wizard keeps it in the gitignored
# .env.sentry-build-plugin rather than here. All four must also be set in the
# hosting provider's environment for production builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only. The Sentry wizard writes this to the gitignored
# .env.sentry-build-plugin instead of .env.local; set it here or there, but it
# must also exist in the hosting provider or source maps will not upload.
SENTRY_AUTH_TOKEN=

# Product analytics (optional - absent means PostHog is simply disabled).
# Only active when NODE_ENV=production. The host must match the region the
# PostHog project lives in: https://eu.i.posthog.com or https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Playwright e2e suite only - real Auth0 test accounts (Username-Password-Authentication).
# The manager account needs app_metadata.role set to "MANAGER" in the Auth0 dashboard.
E2E_WORKER_EMAIL=
E2E_WORKER_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
