generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CARE_WORKER
  MANAGER
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  latitude            Float
  longitude           Float
  clockInRadiusMeters Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users   User[]
  shifts  Shift[]
  digests HandoverDigest[]
  answers AskAnswer[]
}

// Persisted rather than held in memory: on free-tier quota, a cache that empties
// on every cold start is not a cache. Storing it also gives the manager an
// honest "generated at" instead of one that resets when the process does.
model HandoverDigest {
  id             String   @id @default(cuid())
  organizationId String
  date           String
  summary        String
  keyPoints      String[]
  flags          String[]
  generatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
}

// Cache of attendance question answers, per organization. Keyed on a hash of the
// normalized question rather than the text: nothing needs the question back, so
// it is not stored. The answer is what the manager saw (real names), because
// aliases follow the current roster and would drift after a hire.
model AskAnswer {
  organizationId String
  questionHash   String
  answer         String
  answeredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, questionHash])
}

// Per-user question counter, one row per UTC hour. Composite key so the limiter
// can increment in a single INSERT ... ON CONFLICT statement, with no
// read-then-write gap for concurrent requests to slip through.
model AskUsage {
  userId      String
  windowStart DateTime
  count       Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, windowStart])
}

model User {
  id             String   @id @default(cuid())
  auth0UserId    String   @unique
  name           String
  email          String
  role           Role
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  shifts       Shift[]
  askUsage     AskUsage[]

  @@index([organizationId])
}

model Shift {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  clockInAt        DateTime
  clockInLatitude  Float
  clockInLongitude Float
  clockInNote      String?

  clockOutAt        DateTime?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  clockOutNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([userId, clockOutAt])
}
